---
import AppFrame from "@/components/AppFrame.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// The calculator is FIRE_Calculator .html of github.com/mathiasboos/Calculators, shown as it is (scripts/sync-apps.mjs; a
// GitHub Action keeps it up to date). It is Swedish only for now: no English page.
---

<BaseLayout
  title="FIRE-kalkylator – när kan du bli ekonomiskt oberoende?"
  description="Räkna ut när ditt sparande räcker för att leva på avkastningen. FIRE-kalkylatorn tar hänsyn till sparkvot, avkastning, avgifter och skatt på ISK."
  ogTitle="FIRE-kalkylator – Pensionslyft"
  ogDescription="Se vid vilken ålder du kan bli ekonomiskt oberoende."
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-14">
    <h1 class="sr-only">FIRE-kalkylator</h1>
    <AppFrame slug="fire" title="FIRE-kalkylator" />
    <p class="mt-8 max-w-3xl text-sm leading-6 text-muted-foreground">
      Beräkningen är en uppskattning och inte individuell rådgivning. Avkastningen är inte garanterad.
    </p>
  </div>
</BaseLayout>
