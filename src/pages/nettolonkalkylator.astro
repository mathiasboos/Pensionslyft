---
import NettolonCalculator from "@/components/calculators/NettolonCalculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Nettolönkalkylator 2026 – räkna ut din lön efter skatt"
  description="Räkna ut din nettolön för 2026 steg för steg: kommunalskatt, statlig skatt, jobbskatteavdrag, avgifter, löneväxling, kapital, ROT/RUT och fastighetsavgift."
  ogTitle="Nettolönkalkylator 2026 – Pensionslyft"
  ogDescription="Se vad som blir kvar i handen efter skatt, enligt Skatteverkets formler för 2026."
>
  <div class="mx-auto max-w-7xl px-4 py-14">
    <p class="text-xs font-medium tracking-wider text-primary-soft uppercase">
      Inkomstår 2026 · Skatteverket SKVFS 2025:20
    </p>
    <h1 class="mt-2 font-display text-4xl font-semibold">Nettolönkalkylator</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Beräkningsmodell för en privatperson i Sverige 2026. Ange bruttolön, kommunalskattesats och eventuellt
      bruttolöneavdrag. Modellen följer Skatteverkets formler steg för steg, inklusive jobbskatteavdraget.
    </p>
    <div class="mt-10">
      <NettolonCalculator client:load />
    </div>
  </div>
</BaseLayout>
