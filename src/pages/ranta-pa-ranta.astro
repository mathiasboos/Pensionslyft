---
import AppFrame from "@/components/AppFrame.astro";
import AppInfo from "@/components/AppInfo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calculatorText } from "@/data/calculator-text";
import { faqData } from "@/lib/seo";

// The calculator is Compound Interest Calculator.html of github.com/mathiasboos/Calculators, shown as it is
// (scripts/sync-apps.mjs; a GitHub Action keeps it up to date). English page: /en/compound-interest.
const faq = calculatorText["ranta-pa-ranta"]["sv"].faq;
---

<BaseLayout
  jsonLd={faqData(faq)}
  title="Ränta på ränta-kalkylator – Pensionslyft"
  description="Se hur ditt sparande växer med ränta på ränta och hur stor del som är egna insättningar respektive avkastning."
  ogDescription="Räkna på månadssparande, avkastning och avgifter över tid."
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-14">
    <h1 class="sr-only">Ränta på ränta</h1>
    <AppFrame slug="ranta-pa-ranta" title="Ränta på ränta" />
    <AppInfo slug="ranta-pa-ranta" />
    <p class="mt-8 max-w-3xl text-sm leading-6 text-muted-foreground">
      Beräkningen är en uppskattning och inte individuell rådgivning. Avkastningen är inte garanterad.
    </p>
  </div>
</BaseLayout>
