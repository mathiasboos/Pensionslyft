---
import CompoundCalculator from "@/components/calculators/CompoundCalculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ränta på ränta-kalkylator – Pensionslyft"
  description="Se hur ditt sparande växer med ränta på ränta och hur stor del som är egna insättningar respektive avkastning."
  ogDescription="Räkna på månadssparande, avkastning och avgifter över tid."
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="font-serif text-4xl font-semibold">Ränta på ränta</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Den mest kraftfulla effekten i allt sparande. Se hur stor del av slutkapitalet som kommer från
      dina egna pengar – och hur mycket som är avkastning.
    </p>
    <div class="mt-10">
      <CompoundCalculator client:load />
    </div>
  </div>
</BaseLayout>
