---
import CalculatorCard from "@/components/CalculatorCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/lib/format";
import { calculatorGroups } from "@/lib/site-nav";
---

<BaseLayout
  title="Kalkylatorer – Pensionslyft"
  description="Alla Pensionslyfts kalkylatorer: pension, Typfallsmodellen, löneväxling, nettolön 2026, ränta på ränta och FIRE."
  ogDescription="Räkna på pension, lön och sparande med Pensionslyfts kalkylatorer."
>
  <div class="dot-grid">
    <div class="mx-auto max-w-7xl px-4 pt-12 pb-4">
      <p class="eyebrow">Pensionslyft · Kalkylatorer</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Kalkylatorer</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Räkna på din pension, din lön och ditt sparande. Alla kalkylatorer är gratis och räknar direkt i
        webbläsaren.
      </p>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4">
    {
      calculatorGroups.map((group) => (
        <section class="mt-10" aria-labelledby={`grupp-${slugify(group.title)}`}>
          <h2 id={`grupp-${slugify(group.title)}`} class="eyebrow">
            {group.title}
          </h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <CalculatorCard item={item} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
