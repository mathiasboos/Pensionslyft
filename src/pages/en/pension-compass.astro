---
import AppFrame from "@/components/AppFrame.astro";
import AppInfo from "@/components/AppInfo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calculatorText } from "@/data/calculator-text";
import { faqData } from "@/lib/seo";

// The Swedish page is /pensionskompassen. The calculator is the same file, started in English.
const faq = calculatorText["pensionskompassen"]["en"].faq;
---

<BaseLayout
  jsonLd={faqData(faq)}
  title="Pension Compass – plan how you draw your pension"
  description="See what you get a month, year by year, if you draw your occupational and public pension at different ages, evenly or in periods, before or after tax."
  ogTitle="Pension Compass – Pensionslyft"
  ogDescription="Plan how to draw your occupational and public pension and see the monthly amount year by year."
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-14">
    <h1 class="sr-only">Pension Compass</h1>
    <AppFrame slug="pensionskompassen" title="Pension Compass" />
    <AppInfo slug="pensionskompassen" />

  </div>
</BaseLayout>
