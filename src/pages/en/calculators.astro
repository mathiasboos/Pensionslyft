---
import CalculatorCard from "@/components/CalculatorCard.astro";
import CalculatorLevel from "@/components/CalculatorLevel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/lib/format";
import { calculatorGroups, groupTitle, LEVELS, levelText } from "@/lib/site-nav";
---

<BaseLayout
  title="Calculators – Pensionslyft"
  description="All of Pensionslyft's calculators: pension planner, pension savings, the Typfall model, salary exchange, net salary 2026, compound interest and FIRE."
  ogDescription="Calculate your pension, salary and savings with Pensionslyft's calculators."
>
  <div class="dot-grid">
    <div class="mx-auto max-w-7xl px-4 pt-12 pb-4">
      <p class="eyebrow">Pensionslyft · Calculators</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Calculators</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Calculate your pension, your salary and your savings. All calculators are free and work in your browser.
        They are in Swedish for now, and amounts are in Swedish kronor (kr).
      </p>
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
        {
          LEVELS.map((l) => (
            <li class="flex items-center gap-2">
              <CalculatorLevel level={l.level} class="text-foreground" />
              <span>{levelText(l.level, "en")}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4">
    {
      calculatorGroups.map((group) => (
        <section class="mt-10" aria-labelledby={`group-${slugify(groupTitle(group, "en"))}`}>
          <h2 id={`group-${slugify(groupTitle(group, "en"))}`} class="eyebrow">
            {groupTitle(group, "en")}
          </h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <CalculatorCard item={item} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
