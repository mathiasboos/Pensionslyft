---
import BaseLayout from "@/layouts/BaseLayout.astro";

const disclaimer = [
  {
    lead: "Not financial advice.",
    text: "The content and the calculations are general information. They are not financial, legal, tax or other advice and should not be seen as a recommendation to do, or not to do, anything.",
  },
  {
    lead: "Forecasts, not decisions.",
    text: "The results are calculations under the assumptions you enter yourself, such as inflation, growth, return and life expectancy. They are not a prediction and not a guarantee. Reality can differ and rules can change.",
  },
  {
    lead: "Simplifications.",
    text: "The models are simplifications of reality, for example when it comes to tax and private savings.",
  },
  {
    lead: "Unofficial.",
    text: "Pensionslyft is not developed by, connected to or approved by the Swedish Pensions Agency (Pensionsmyndigheten). The Typfall model, its data and its user manual belong to the Pensions Agency.",
  },
  {
    lead: "Your own responsibility.",
    text: "You use the site at your own risk. To the extent the law allows, Pensionslyft is not responsible for decisions made or losses incurred on the basis of the content.",
  },
  {
    lead: "Check for yourself.",
    text: "Compare with your own pension forecast on minPension.se and with your occupational pension provider, and turn to an independent adviser if needed before you make a decision.",
  },
  {
    lead: "Privacy.",
    text: "All calculations are made in your browser. What you enter is not sent anywhere.",
  },
];
---

<BaseLayout
  title="About Pensionslyft – independent guides to Swedish pension"
  description="What Pensionslyft is for, what the site is not and how to contact us. Independent guides and calculators about the Swedish pension system, with no ads."
  ogDescription="Independent guides and calculators about the Swedish pension system."
>
  <div class="dot-grid">
    <div class="mx-auto max-w-7xl px-4 pt-12 pb-6">
      <p class="eyebrow">Pensionslyft</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">About Pensionslyft</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        We want to share knowledge, inspire and put the pension question on the map, so that you can make well-founded
        decisions that suit you and your situation.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 pb-4">
    <section class="grid gap-4 border-t border-border py-8 lg:grid-cols-[16rem_1fr] lg:gap-10">
      <h2 class="eyebrow pt-1">Good to know</h2>
      <ul class="max-w-3xl space-y-4 text-sm leading-6 text-muted-foreground">
        {
          disclaimer.map((item) => (
            <li>
              <span class="font-medium text-foreground">{item.lead}</span> {item.text}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="grid gap-4 border-t border-border py-8 lg:grid-cols-[16rem_1fr] lg:gap-10">
      <h2 class="eyebrow pt-1">Language</h2>
      <p class="max-w-3xl text-sm leading-6 text-muted-foreground">
        Pensionslyft is written in Swedish first. The articles and the news are also available in English, together with the
        home page, the list of calculators and this page. Most calculators and the reports are in Swedish for now. The
        pages about Swedish rules also use Swedish terms, which we explain in English where we can.
      </p>
    </section>

    <section class="grid gap-4 border-t border-border py-8 lg:grid-cols-[16rem_1fr] lg:gap-10">
      <h2 class="eyebrow pt-1">Contact</h2>
      <p class="max-w-3xl text-sm leading-6 text-muted-foreground">
        Questions, comments or mistakes? Write to{" "}
        <a href="mailto:info@pensionslyft.se" class="text-primary underline underline-offset-2">info@pensionslyft.se</a>.
      </p>
    </section>
  </div>
</BaseLayout>
