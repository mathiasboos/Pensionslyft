---
import AppFrame from "@/components/AppFrame.astro";
import AppInfo from "@/components/AppInfo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calculatorText } from "@/data/calculator-text";
import { faqData } from "@/lib/seo";

// The Swedish page is /ranta-pa-ranta. The calculator is the same file, started in English.
const faq = calculatorText["ranta-pa-ranta"]["en"].faq;
---

<BaseLayout
  jsonLd={faqData(faq)}
  title="Compound interest calculator – Pensionslyft"
  description="See how your saving grows with compound interest, and how much is your own deposits and how much is the return."
  ogDescription="Work out monthly saving, return and fees over time."
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-14">
    <h1 class="sr-only">Compound interest</h1>
    <AppFrame slug="ranta-pa-ranta" title="Compound interest" />
    <AppInfo slug="ranta-pa-ranta" />
    <p class="mt-8 max-w-3xl text-sm leading-6 text-muted-foreground">
      The calculation is an estimate and not individual advice. The return is not guaranteed. Amounts are in Swedish
      kronor (kr).
    </p>
  </div>
</BaseLayout>
