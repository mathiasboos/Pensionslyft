---
import AppFrame from "@/components/AppFrame.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// The calculator is Salary_Exchange.html of github.com/mathiasboos/Calculators, shown as it is with the site's colours
// and fonts (scripts/sync-apps.mjs, scripts/apps-colors.mjs, scripts/apps/lonevaxling.css; a GitHub Action keeps it up
// to date). English page: /en/salary-exchange.
---

<BaseLayout
  title="Löneväxlingskalkylator 2026 – vad ger löneväxling?"
  description="Räkna ut vad löneväxling till pension ger: månadssparande inklusive arbetsgivarens skatteskillnad, förväntat pensionskapital och när löneväxling är lämpligt."
  ogTitle="Löneväxlingskalkylator – Pensionslyft"
  ogDescription="Se hur mycket extra pensionskapital löneväxling kan ge och om det passar din lönenivå."
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-14">
    <h1 class="sr-only">Löneväxlingskalkylator 2026</h1>
    <AppFrame slug="lonevaxling" title="Löneväxlingskalkylator 2026" />
  </div>
</BaseLayout>
