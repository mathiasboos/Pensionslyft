---
import PensionsoversiktCalculator from "@/components/calculators/PensionsoversiktCalculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pensionsöversikt – räcker pensionen? – Pensionslyft"
  description="Se om din pension och ditt sparande räcker: allmän pension och tjänstepension, skatt, budget och hur mycket mer du behöver spara varje månad."
  ogTitle="Pensionsöversikt – Pensionslyft"
  ogDescription="Räcker pensionen och sparandet? Se din prognos och hur mycket mer du behöver spara."
>
  <div class="mx-auto max-w-7xl px-4 py-14">
    <h1 class="font-display text-4xl font-semibold">Pensionsöversikt</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Berätta lite om din ekonomi i dag. Pensionsöversikten räknar ut din allmänna pension och tjänstepension, drar
      skatten och visar om pensionen och ditt sparande räcker till den budget du vill ha som pensionär – och hur mycket
      mer du i så fall behöver spara.
    </p>
    <div class="mt-10">
      <PensionsoversiktCalculator client:load />
    </div>
  </div>
</BaseLayout>
