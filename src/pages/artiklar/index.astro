---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticles } from "@/lib/articles";

const articles = await getArticles();
---

<BaseLayout
  title="Artiklar om pension – Pensionslyft"
  description="Guider och analyser om allmän pension, tjänstepension, avgifter och uttagsstrategier."
  ogDescription="Guider och analyser om svensk pension från Pensionslyft."
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="font-serif text-4xl font-semibold">Artiklar</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      Allt du behöver för att fatta bättre pensionsbeslut – förklarat på svenska, utan säljsnack.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    {articles.length === 0 && <p class="mt-10 text-muted-foreground">Inga artiklar här ännu.</p>}
  </div>
</BaseLayout>
