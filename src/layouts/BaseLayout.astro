---
import "@/styles/global.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { calculators } from "@/lib/site-nav";
import { DEFAULT_IMAGE, DEFAULT_IMAGE_ALT, absolute, breadcrumbs as breadcrumbData, homeData, webApplication } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  /** Structured data (schema.org) added as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The trail above the page, without the home page: shown to Google as a breadcrumb. */
  breadcrumbs?: { name: string; path: string }[];
  /** Share image, a path on the site (1200×630). Defaults to the brand image. */
  image?: string;
  imageAlt?: string;
  /** For articles and news: the search words and the publishing date. */
  tags?: string[];
  publishedTime?: Date;
}

const {
  title = "Pensionslyft – pension, kalkyler och guider",
  description = "Pensionslyft förklarar svensk pension med guider, artiklar och kalkylatorer för pensionskapital och ränta på ränta.",
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  jsonLd,
  breadcrumbs,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_IMAGE_ALT,
  tags = [],
  publishedTime,
} = Astro.props;

// Pages are built as /artiklar.html, but served (and linked) as /artiklar.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const canonical = new URL(path, Astro.site);
const imageUrl = absolute(image);

// Structured data: what the page sets itself, plus the home page's site data and the calculators' app data.
const calculator = calculators.find((c) => c.href === path);
const words = tags.length > 0 ? tags : (calculator?.keywords ?? []);
const data = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(path === "/" ? homeData() : []),
  ...(calculator
    ? [
        webApplication({ name: calculator.title, description, path, keywords: calculator.keywords }),
        breadcrumbData([
          { name: "Kalkylatorer", path: "/kalkylatorer" },
          { name: calculator.title, path },
        ]),
      ]
    : []),
  ...(breadcrumbs ? [breadcrumbData(breadcrumbs)] : []),
];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pensionslyft" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Pensionslyft" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {words.length > 0 && <meta name="keywords" content={words.join(", ")} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="application/rss+xml" title="Pensionslyft – Nyheter" href="/nyheter/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    {data.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "@/scripts/dot-ripple";
    </script>
  </body>
</html>
