---
import { calculatorGroups, groupTitle, insightsFor, navItem } from "@/lib/site-nav";
import { langOf } from "@/lib/i18n";
import { ui } from "@/i18n/ui";

const year = new Date().getFullYear();
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const insights = insightsFor(lang);
const t = ui[lang];
const groups = calculatorGroups.map((g) => ({ ...g, title: groupTitle(g, lang), items: g.items.map((i) => navItem(i, lang)) }));
const calcHref = en ? "/en/calculators" : "/kalkylatorer";
const aboutHref = en ? "/en/about" : "/om-pensionslyft";
---

<footer class="mt-24 border-t border-border bg-muted">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-lg font-semibold text-primary">Pensionslyft</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-muted-foreground">
        {t["footer.about"]}
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        {t["footer.contact"]}{" "}
        <a href="mailto:info@pensionslyft.se" class="text-foreground/80 hover:text-primary hover:underline">
          info@pensionslyft.se
        </a>
      </p>
    </div>
    {
      groups.map((group) => (
        <div>
          <p class="eyebrow">{group.title}</p>
          <ul class="mt-4 space-y-3 text-sm">
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="text-foreground/80 hover:text-primary hover:underline">
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="eyebrow">{t["nav.insights"]}</p>
      <ul class="mt-4 space-y-3 text-sm">
        {
          insights.map((item) => (
            <li>
              <a href={item.href} class="text-foreground/80 hover:text-primary hover:underline">
                {item.title}
              </a>
            </li>
          ))
        }
        <li>
          <a href={calcHref} class="text-foreground/80 hover:text-primary hover:underline">{t["nav.allCalculators"]}</a>
        </li>
        <li>
          <a href={aboutHref} class="text-foreground/80 hover:text-primary hover:underline">{t["nav.about"]}</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-muted-foreground">
      © {year} Pensionslyft. {t["footer.copyright"]}
    </p>
  </div>
</footer>
