---
import { ArrowRight, ChevronDown, Menu, X } from "lucide-react";
import ArticleCover from "@/components/ArticleCover.astro";
import { buttonVariants } from "@/components/ui/button";
import { coverOf, getArticles } from "@/lib/articles";
import CalculatorLevel from "@/components/CalculatorLevel.astro";
import { calculatorGroups, featuredCalculator, groupTitle, insightsFor, navItem } from "@/lib/site-nav";
import { articlePath, articlesListPath, cleanPath, HOME, langOf, newsListPath, stayMode, switchTarget } from "@/lib/i18n";
import { ui } from "@/i18n/ui";
import { cn } from "@/lib/utils";

const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const articles = await getArticles(lang);
const latest = articles[0];
const latestCover = latest ? await coverOf(latest) : undefined;
const categories = [...new Set(articles.map((a) => a.data.category))].sort((a, b) => a.localeCompare(b, en ? "en" : "sv"));
const insights = insightsFor(lang);
const categoryParam = en ? "category" : "kategori";
const articlesHref = articlesListPath(lang);
const newsHref = newsListPath(lang);

const path = Astro.url.pathname.replace(/\.html$/, "");
const t = ui[lang];
const groups = calculatorGroups.map((g) => ({ ...g, title: groupTitle(g, lang), items: g.items.map((i) => navItem(i, lang)) }));
const featured = navItem(featuredCalculator, lang);
const calcHref = en ? "/en/calculators" : "/kalkylatorer";
const aboutHref = en ? "/en/about" : "/om-pensionslyft";
// The other language: the same page if it exists there, else the front page of that language.
const target = switchTarget(Astro.url.pathname);
const here = cleanPath(Astro.url.pathname);
const stay = stayMode(Astro.url.pathname);
const svHref = stay ? here : en ? target : here;
const enHref = stay ? here : en ? here : target;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const calculatorsActive =
  isActive(calcHref) || calculatorGroups.some((g) => g.items.some((item) => isActive(item.href) || (item.enHref !== undefined && isActive(item.enHref))));
const insightsActive = insights.some((item) => isActive(item.href));

const trigger =
  "group inline-flex cursor-pointer items-center gap-1 rounded-md px-3 py-2 text-sm transition-colors hover:text-primary aria-expanded:text-primary";
const plainLink = "rounded-md px-3 py-2 text-sm transition-colors hover:text-primary";
const FeaturedIcon = featured.icon;
---

<header class="sticky top-0 z-50 border-b border-border bg-background" data-site-header>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4">
    <a href={HOME[lang]} class="flex shrink-0 items-center gap-1.5 text-primary" aria-label={t["site.homeAria"]}>
      <span class="font-display text-xl font-semibold">Pensionslyft</span>
      <svg viewBox="0 0 20 20" class="size-5" aria-hidden="true">
        <polyline
          points="2,15 7,10 10.5,12.5 17,5"
          fill="none"
          stroke="var(--highlight)"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
        <polyline
          points="12.5,5 17,5 17,9.5"
          fill="none"
          stroke="var(--highlight)"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
      </svg>
    </a>

    <nav class="hidden h-full items-center lg:flex" aria-label={t["nav.main"]}>
      <div class="flex h-full items-center" data-mega>
        <button
          type="button"
          class:list={[trigger, calculatorsActive ? "font-medium text-primary" : "text-foreground/80"]}
          aria-expanded="false"
          aria-controls="mega-kalkylatorer"
          data-mega-trigger
        >
          {t["nav.calculators"]}
          <ChevronDown className="size-4 transition-transform group-aria-expanded:rotate-180" aria-hidden="true" />
        </button>
        <div id="mega-kalkylatorer" class="absolute inset-x-0 top-full z-10 px-4 pt-2" hidden data-mega-panel>
          <div
            class="mx-auto grid max-w-7xl grid-cols-[1fr_1fr_20rem] overflow-hidden rounded-xl border border-border bg-card shadow-[var(--shadow-panel)]"
          >
            {
              groups.map((group) => (
                <div class="border-r border-border p-6">
                  <p class="eyebrow px-2">{group.title}</p>
                  <ul class="mt-3 space-y-1">
                    {group.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          aria-current={isActive(item.href) ? "page" : undefined}
                          class="group/item flex gap-3 rounded-lg p-2 transition-colors hover:bg-muted"
                        >
                          <span class="grid size-10 shrink-0 place-items-center rounded-md bg-muted text-primary transition-colors group-hover/item:bg-primary group-hover/item:text-primary-foreground">
                            <item.icon className="size-5" aria-hidden="true" />
                          </span>
                          <span>
                            <span class="block text-sm font-medium text-foreground">{item.title}</span>
                            {item.level && <CalculatorLevel level={item.level} class="mt-0.5" />}
                            <span class="mt-0.5 block text-sm leading-5 text-muted-foreground">
                              {item.description}
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <div class="bg-muted p-6">
              <p class="eyebrow">{t["nav.featured"]}</p>
              <a href={featured.href} class="group/feat mt-3 block">
                <span
                  class="grid aspect-[16/9] place-items-center rounded-lg text-primary-foreground"
                  style="background: var(--gradient-deep)"
                >
                  <FeaturedIcon className="size-10 text-highlight" aria-hidden="true" />
                </span>
                <span class="mt-3 block text-sm font-medium text-foreground group-hover/feat:text-primary">
                  {t["nav.featuredNew"]} {featured.title}
                </span>
                <span class="mt-0.5 block text-sm leading-5 text-muted-foreground">
                  {featured.description}
                </span>
              </a>
              <a
                href={calcHref}
                class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
              >
                {t["nav.allCalculators"]} <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="flex h-full items-center" data-mega>
        <button
          type="button"
          class:list={[trigger, insightsActive ? "font-medium text-primary" : "text-foreground/80"]}
          aria-expanded="false"
          aria-controls="mega-insikter"
          data-mega-trigger
        >
          {t["nav.insights"]}
          <ChevronDown className="size-4 transition-transform group-aria-expanded:rotate-180" aria-hidden="true" />
        </button>
        <div id="mega-insikter" class="absolute inset-x-0 top-full z-10 px-4 pt-2" hidden data-mega-panel>
          <div
            class="mx-auto grid max-w-7xl grid-cols-[1fr_1fr_20rem] overflow-hidden rounded-xl border border-border bg-card shadow-[var(--shadow-panel)]"
          >
            <div class="border-r border-border p-6">
              <p class="eyebrow px-2">{t["nav.readAndDeepen"]}</p>
              <ul class="mt-3 space-y-1">
                {
                  insights.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isActive(item.href) ? "page" : undefined}
                        class="group/item flex gap-3 rounded-lg p-2 transition-colors hover:bg-muted"
                      >
                        <span class="grid size-10 shrink-0 place-items-center rounded-md bg-muted text-primary transition-colors group-hover/item:bg-primary group-hover/item:text-primary-foreground">
                          <item.icon className="size-5" aria-hidden="true" />
                        </span>
                        <span>
                          <span class="block text-sm font-medium text-foreground">{item.title}</span>
                          <span class="mt-0.5 block text-sm leading-5 text-muted-foreground">
                            {item.description}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="border-r border-border p-6">
              <p class="eyebrow">{t["nav.topics"]}</p>
              <ul class="mt-3 space-y-3">
                {
                  categories.map((category) => (
                    <li>
                      <a
                        href={`${articlesHref}?${categoryParam}=${encodeURIComponent(category)}`}
                        class="text-sm text-foreground hover:text-primary hover:underline"
                      >
                        {category}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="bg-muted p-6">
              <p class="eyebrow">{t["nav.latestArticle"]}</p>
              {
                latest && (
                  <a href={articlePath(lang, latest.id)} class="group/feat mt-3 block">
                    <ArticleCover
                      seed={latestCover?.seed ?? latest.id}
                      category={latestCover?.category ?? latest.data.category}
                      class="aspect-[16/9] rounded-lg"
                    />
                    <span class="mt-3 block text-sm font-medium text-foreground group-hover/feat:text-primary">
                      {latest.data.title}
                    </span>
                    <span class="mt-0.5 line-clamp-2 block text-sm leading-5 text-muted-foreground">
                      {latest.data.excerpt}
                    </span>
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </div>

      <a
        href={articlesHref}
        aria-current={isActive(articlesHref) ? "page" : undefined}
        class:list={[plainLink, isActive(articlesHref) ? "font-medium text-primary" : "text-foreground/80"]}
      >
        {t["nav.articles"]}
      </a>
      {
        !en && (
          <a
            href="/rapporter"
            aria-current={isActive("/rapporter") ? "page" : undefined}
            class:list={[plainLink, isActive("/rapporter") ? "font-medium text-primary" : "text-foreground/80"]}
          >
            {t["nav.reports"]}
          </a>
        )
      }
      <a
        href={newsHref}
        aria-current={isActive(newsHref) ? "page" : undefined}
        class:list={[plainLink, isActive(newsHref) ? "font-medium text-primary" : "text-foreground/80"]}
      >
        {t["nav.news"]}
      </a>
      <a
        href={aboutHref}
        aria-current={isActive(aboutHref) ? "page" : undefined}
        class:list={[plainLink, isActive(aboutHref) ? "font-medium text-primary" : "text-foreground/80"]}
      >
        {t["nav.about"]}
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <div class="flex items-center text-sm" role="group" aria-label={t["lang.switchAria"]}>
        <a
          href={svHref}
          lang="sv"
          hreflang="sv"
          data-lang-switch="sv"
          data-stay={stay}
          title={t["lang.toSwedish"]}
          aria-current={en ? undefined : "true"}
          class:list={["rounded-md px-2 py-1.5 transition-colors hover:text-primary", en ? "text-foreground/70" : "font-semibold text-primary"]}>SV</a
        >
        <span class="text-border" aria-hidden="true">|</span>
        <a
          href={enHref}
          lang="en"
          hreflang="en"
          data-lang-switch="en"
          data-stay={stay}
          title={t["lang.toEnglish"]}
          aria-current={en ? "true" : undefined}
          class:list={["rounded-md px-2 py-1.5 transition-colors hover:text-primary", en ? "font-semibold text-primary" : "text-foreground/70"]}>EN</a
        >
      </div>
      <a href="/pensionsoversikt" class={cn(buttonVariants({ variant: "highlight" }), "hidden sm:inline-flex")}>
        {t["nav.cta"]}
      </a>
      <a href={calcHref} class={cn(buttonVariants(), "hidden shadow-none lg:inline-flex")}>
        {t["nav.allCalculators"]}
      </a>
      <button
        type="button"
        class="-mr-2 grid size-10 cursor-pointer place-items-center rounded-md lg:hidden"
        aria-label={t["nav.menu"]}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Menu className="size-5" data-icon-open />
        <X className="hidden size-5" data-icon-close />
      </button>
    </div>
  </div>

  {
    stay === "swedish-only" && (
      <div id="lang-note" class="border-t border-border bg-muted" role="status" hidden>
        <p class="mx-auto max-w-7xl px-4 py-2 text-sm">
          Typfallsmodellen finns bara på svenska ännu. <span lang="en" class="text-muted-foreground">The Typfall model is only available in Swedish for now.</span>
        </p>
      </div>
    )
  }

  {
    !en && !stay && (
      <div id="lang-hint" class="border-t border-border bg-muted" hidden>
        <p class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-sm">
          <span lang="en">{ui.en["hint.text"]}</span>
          <a href={enHref} lang="en" hreflang="en" data-lang-switch="en" class="font-medium text-primary underline underline-offset-2">
            {ui.en["hint.link"]}
          </a>
          <button type="button" class="ml-auto cursor-pointer text-muted-foreground hover:text-foreground" data-hint-dismiss>
            {t["hint.dismiss"]}
          </button>
        </p>
      </div>
    )
  }

  <div class="fixed inset-x-0 top-16 bottom-0 z-0 bg-foreground/20" hidden data-mega-overlay></div>

  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-16 bottom-0 overflow-y-auto overscroll-contain bg-background lg:hidden"
    hidden
  >
    <nav class="mx-auto max-w-7xl px-4 pb-10" aria-label={t["nav.main"]}>
      <details class="group border-b border-border" open={calculatorsActive}>
        <summary
          class="flex cursor-pointer list-none items-center justify-between py-4 text-base font-medium [&::-webkit-details-marker]:hidden"
        >
          {t["nav.calculators"]}
          <ChevronDown className="size-5 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        {
          groups.map((group) => (
            <div class="pb-4">
              <p class="eyebrow">{group.title}</p>
              <ul class="mt-2 space-y-1">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class:list={[
                        "flex items-center gap-3 rounded-lg py-2",
                        isActive(item.href) && "font-medium text-primary",
                      ]}
                    >
                      <span class="grid size-9 shrink-0 place-items-center rounded-md bg-muted text-primary">
                        <item.icon className="size-4" aria-hidden="true" />
                      </span>
                      <span class="flex flex-col">
                        <span class="text-sm">{item.title}</span>
                        {item.level && <CalculatorLevel level={item.level} />}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <a href={calcHref} class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-primary">
          {t["nav.allCalculators"]} <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </details>
      <details class="group border-b border-border" open={insightsActive}>
        <summary
          class="flex cursor-pointer list-none items-center justify-between py-4 text-base font-medium [&::-webkit-details-marker]:hidden"
        >
          {t["nav.insights"]}
          <ChevronDown className="size-5 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <ul class="space-y-1 pb-4">
          {
            insights.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-3 rounded-lg py-2",
                    isActive(item.href) && "font-medium text-primary",
                  ]}
                >
                  <span class="grid size-9 shrink-0 place-items-center rounded-md bg-muted text-primary">
                    <item.icon className="size-4" aria-hidden="true" />
                  </span>
                  <span class="text-sm">{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="eyebrow">{t["nav.topics"]}</p>
        <ul class="mt-2 flex flex-wrap gap-2 pb-5">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`${articlesHref}?${categoryParam}=${encodeURIComponent(category)}`}
                  class="inline-block rounded-full border border-border px-3 py-1 text-sm"
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href={articlesHref} class="block border-b border-border py-4 text-base font-medium">{t["nav.articles"]}</a>
      {!en && <a href="/rapporter" class="block border-b border-border py-4 text-base font-medium">{t["nav.reports"]}</a>}
      <a href={newsHref} class="block border-b border-border py-4 text-base font-medium">{t["nav.news"]}</a>
      <a href={aboutHref} class="block border-b border-border py-4 text-base font-medium">{t["nav.about"]}</a>
      <div class="mt-8 grid gap-3">
        <a href="/pensionsoversikt" class={cn(buttonVariants({ variant: "highlight", size: "lg" }))}>
          {t["nav.cta"]}
        </a>
        <a href={calcHref} class={cn(buttonVariants({ size: "lg" }), "shadow-none")}>{t["nav.allCalculators"]}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  /*
   * The menus of the header.
   *
   * On a computer a panel opens when the pointer rests on its title (after 80 ms, so that passing over it does
   * not open it) and closes 200 ms after the pointer has left both the title and the panel, so the pointer can
   * travel down into it. A click, a tap, Enter or Space opens and closes it too, and Escape closes it and puts
   * the focus back on the title. On a phone the hamburger opens a sheet with the same links.
   */
  const OPEN_DELAY = 80;
  const CLOSE_DELAY = 200;

  type Mega = { root: HTMLElement; trigger: HTMLButtonElement; panel: HTMLElement };

  const overlay = document.querySelector<HTMLElement>("[data-mega-overlay]");
  const megas: Mega[] = [...document.querySelectorAll<HTMLElement>("[data-mega]")].map((root) => ({
    root,
    trigger: root.querySelector<HTMLButtonElement>("[data-mega-trigger]")!,
    panel: root.querySelector<HTMLElement>("[data-mega-panel]")!,
  }));

  let current: Mega | null = null;
  let openedAt = 0;
  let timer = 0;

  function show(mega: Mega | null) {
    window.clearTimeout(timer);
    if (current === mega) return;
    if (current) {
      current.panel.hidden = true;
      current.trigger.setAttribute("aria-expanded", "false");
    }
    current = mega;
    if (mega) {
      mega.panel.hidden = false;
      mega.trigger.setAttribute("aria-expanded", "true");
      openedAt = Date.now();
    }
    if (overlay) overlay.hidden = !mega;
  }

  for (const mega of megas) {
    mega.root.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      window.clearTimeout(timer);
      if (current && current !== mega) show(mega);
      else if (!current) timer = window.setTimeout(() => show(mega), OPEN_DELAY);
    });
    mega.root.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (current === mega) show(null);
      }, CLOSE_DELAY);
    });
    mega.trigger.addEventListener("click", () => {
      // A click just after the pointer opened the panel keeps it open instead of closing it again.
      if (current === mega) {
        if (Date.now() - openedAt > 400) show(null);
      } else {
        show(mega);
      }
    });
    mega.root.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (current === mega && next && !mega.root.contains(next)) show(null);
    });
  }

  overlay?.addEventListener("click", () => show(null));

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !current) return;
    const trigger = current.trigger;
    show(null);
    trigger.focus();
  });

  // Language. A choice made with the switch is remembered. A visitor with an English browser, or who chose English
  // before, is shown a hint on the Swedish pages; nobody is redirected (search engines never are).
  const store = {
    get: (key: string) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set: (key: string, value: string) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        // storage can be blocked; the switch still works
      }
    },
  };
  // On an embedded tool without an English page the switch stays on the page (see stayMode in src/lib/i18n.ts).
  const PLANNER_KEY = "pensionslyft.planner.lang"; // the key scripts/pensionsplaneraren-site.js keeps the planner's language in
  const switches = Array.from(document.querySelectorAll<HTMLAnchorElement>("[role=group] [data-lang-switch]"));
  const stayMode = switches[0]?.dataset.stay;
  const showLang = (lang: string) =>
    switches.forEach((link) => {
      const on = link.dataset.langSwitch === lang;
      link.classList.toggle("font-semibold", on);
      link.classList.toggle("text-primary", on);
      link.classList.toggle("text-foreground/70", !on);
      if (on) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
  const plannerFrame = () => document.querySelector<HTMLIFrameElement>("iframe");
  const setPlannerLang = (lang: string) => {
    store.set(PLANNER_KEY, lang);
    try {
      (plannerFrame()?.contentWindow as (Window & { setLang?: (l: string) => void }) | null | undefined)?.setLang?.(lang);
    } catch {
      // the frame is not ready; it reads the stored choice when it starts
    }
    showLang(lang);
  };
  if (stayMode === "planner") {
    showLang(store.get(PLANNER_KEY) === "en" ? "en" : "sv");
    // A click on EN or SV inside the planner moves the header with it.
    const follow = () => {
      plannerFrame()?.contentDocument?.addEventListener("click", (e) => {
        const button = (e.target as Element | null)?.closest?.(".lang-btn[data-lang]");
        if (button) showLang(button.getAttribute("data-lang") ?? "sv");
      });
    };
    const frame = plannerFrame();
    frame?.addEventListener("load", follow);
    if (frame?.contentDocument?.readyState === "complete") follow();
  } else if (stayMode === "swedish-only") {
    showLang("sv");
  }
  switches.forEach((link) => {
    link.addEventListener("click", (event) => {
      const lang = link.dataset.langSwitch ?? "sv";
      if (stayMode === "planner") {
        event.preventDefault();
        setPlannerLang(lang);
      } else if (stayMode === "swedish-only") {
        event.preventDefault();
        const note = document.getElementById("lang-note");
        if (lang === "en" && note) {
          note.hidden = false;
          window.setTimeout(() => (note.hidden = true), 6000);
        }
      } else {
        store.set("pl-lang", lang);
      }
    });
  });
  document.querySelectorAll<HTMLElement>("#lang-hint [data-lang-switch]").forEach((link) => {
    link.addEventListener("click", () => store.set("pl-lang", link.dataset.langSwitch ?? "sv"));
  });
  const hint = document.getElementById("lang-hint");
  if (hint) {
    const chosen = store.get("pl-lang");
    const wantsEnglish = chosen === "en" || (chosen === null && navigator.language.toLowerCase().startsWith("en"));
    if (wantsEnglish && store.get("pl-lang-hint") !== "dismissed") hint.hidden = false;
    hint.querySelector("[data-hint-dismiss]")?.addEventListener("click", () => {
      hint.hidden = true;
      store.set("pl-lang-hint", "dismissed");
    });
  }

  // The sheet on phones.
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const sheet = document.getElementById("mobile-menu");

  function setSheet(open: boolean) {
    if (!toggle || !sheet) return;
    sheet.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
    // The page behind the sheet does not scroll while it is open.
    document.documentElement.classList.toggle("overflow-hidden", open);
  }

  toggle?.addEventListener("click", () => setSheet(Boolean(sheet?.hidden)));

  // Wider than a phone, the sheet is not shown, so it must not keep the page from scrolling.
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setSheet(false);
    else show(null);
  });
</script>
