---
import { Menu, X } from "lucide-react";

const links = [
  { href: "/artiklar", label: "Artiklar" },
  { href: "/pensionskalkylator", label: "Pensionskalkylator" },
  { href: "/ranta-pa-ranta", label: "Ränta på ränta" },
];

const path = Astro.url.pathname.replace(/\.html$/, "");
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-serif text-xl font-semibold tracking-tight text-primary">Pensionslyft</span>
      <span class="hidden text-xs tracking-[0.2em] text-muted-foreground uppercase sm:inline">.se</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Huvudmeny">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "text-sm transition-colors hover:text-primary",
              isActive(l.href) ? "font-medium text-primary" : "text-foreground/80",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="cursor-pointer md:hidden"
      aria-label="Meny"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Menu className="size-5" data-icon-open />
      <X className="hidden size-5" data-icon-close />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border bg-background px-4 py-3 md:hidden">
    <nav class="flex flex-col gap-3" aria-label="Huvudmeny">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={["text-sm", isActive(l.href) && "font-medium text-primary"]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
  });
</script>
