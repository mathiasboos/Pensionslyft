---
import { langOf } from "@/lib/i18n";
import { LEVELS, levelName, type Level } from "@/lib/site-nav";
import { ui } from "@/i18n/ui";

interface Props {
  level: Level;
  class?: string;
}

const { level, class: className } = Astro.props;
const lang = langOf(Astro.url.pathname);
const label = ui[lang]["level.label"];
const filled = LEVELS.findIndex((l) => l.level === level) + 1;
---

<span
  class:list={["inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground", className]}
  title={`${label}: ${levelName(level, lang)}`}
>
  <span class="inline-flex gap-1" aria-hidden="true">
    {
      LEVELS.map((_, i) => (
        <span class:list={["size-1.5 rounded-full", i < filled ? "bg-primary" : "bg-input"]} />
      ))
    }
  </span>
  <span class="sr-only">{label}: </span>{levelName(level, lang)}
</span>
