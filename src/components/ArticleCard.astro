---
import ArticleCover from "@/components/ArticleCover.astro";
import { formatDate } from "@/lib/format";
import { articlePath, langOf } from "@/lib/i18n";
import { coverOf, type Article } from "@/lib/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const lang = langOf(Astro.url.pathname);
const { title, category, excerpt, published_at, reading_minutes } = article.data;
const cover = await coverOf(article);
---

<a href={articlePath(lang, article.id)} class="group flex h-full flex-col" data-category={category}>
  <ArticleCover
    seed={cover.seed}
    category={cover.category}
    class="aspect-[16/9] rounded-lg transition-opacity group-hover:opacity-90"
  />
  <p class="eyebrow mt-4">{category} · {reading_minutes} {lang === "en" ? "min read" : "min läsning"}</p>
  <h3 class="mt-2 font-display text-lg leading-snug font-semibold text-foreground group-hover:text-primary-soft">
    {title}
  </h3>
  <p class="mt-2 line-clamp-3 flex-1 text-sm leading-6 text-muted-foreground">{excerpt}</p>
  <time class="mt-3 text-xs text-muted-foreground" datetime={published_at.toISOString().slice(0, 10)}>
    {formatDate(published_at, lang)}
  </time>
</a>
