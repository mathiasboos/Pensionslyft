---
import { Clock } from "lucide-react";
import { formatDate } from "@/lib/format";
import type { Article } from "@/lib/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, category, excerpt, published_at, reading_minutes } = article.data;
---

<a
  href={`/artiklar/${article.id}`}
  class="group flex h-full flex-col rounded-xl border border-border bg-card p-6 transition-shadow hover:shadow-[var(--shadow-soft)]"
>
  <div class="flex items-center gap-2 text-xs tracking-wider text-muted-foreground uppercase">
    <span>{category}</span>
  </div>
  <h3 class="mt-3 font-serif text-xl font-semibold text-foreground group-hover:text-primary-soft">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-muted-foreground">{excerpt}</p>
  <div class="mt-4 flex items-center gap-3 text-xs text-muted-foreground">
    <span>{formatDate(published_at)}</span>
    <span class="inline-flex items-center gap-1">
      <Clock className="size-3" aria-hidden="true" />
      {reading_minutes} min
    </span>
  </div>
</a>
