---
import { ArrowRight, ChevronLeft, ChevronRight } from "lucide-react";
import { formatDate } from "@/lib/format";
import { langOf, newsPath } from "@/lib/i18n";
import { hashtag } from "@/lib/tags";
import type { NewsItem } from "@/lib/news";

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
// One accent colour per slide, in a fixed order (the site's gold, steel, teal, sand ...).
const accents = ["#f0c75e", "#8fb4dc", "#7fcfc4", "#e3b9a3", "#d9c9a3", "#b4c2de"];
---

{
  items.length > 0 && (
    <section
      class="mx-auto max-w-7xl px-4"
      aria-roledescription="carousel"
      aria-label={en ? "Latest news" : "Senaste nyheterna"}
      data-news-slider
    >
      <div class="relative">
        <div
          data-track
          class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-2xl [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {items.map((item, i) => (
            <a
              href={newsPath(lang, item.id)}
              data-slide
              aria-roledescription="slide"
              aria-label={en ? `${i + 1} of ${items.length}` : `${i + 1} av ${items.length}`}
              class="news-slide group relative flex min-h-[26rem] w-full shrink-0 snap-start flex-col justify-end overflow-hidden bg-primary p-6 text-primary-foreground sm:min-h-[22rem] sm:p-10"
              style={`--slide-accent: ${accents[i % accents.length]}`}
            >
              <span class="absolute top-6 left-6 flex flex-wrap items-center gap-x-3 gap-y-1 sm:top-10 sm:left-10">
                <span class="rounded-full bg-[var(--slide-accent)] px-2.5 py-0.5 font-mono text-[0.7rem] tracking-wider text-primary uppercase">
                  {en ? "News" : "Nyhet"}
                </span>
                <span class="font-mono text-[0.7rem] tracking-wider text-primary-foreground/75 uppercase">
                  {item.data.source} · {formatDate(item.data.published_at, lang)}
                </span>
              </span>
              <span class="mt-16 block max-w-4xl font-display text-2xl leading-[1.15] font-semibold break-words hyphens-auto group-hover:underline sm:text-5xl">
                {item.data.title}
              </span>
              <span class="mt-3 line-clamp-2 block max-w-2xl text-sm text-primary-foreground/80 sm:text-base">
                {item.data.excerpt}
              </span>
              <span class="mt-5 flex flex-wrap items-center gap-2 pr-28">
                <span class="inline-flex items-center gap-1 text-sm font-medium text-[var(--slide-accent)]">
                  {en ? "Read the news item" : "Läs nyheten"} <ArrowRight className="size-4" aria-hidden="true" />
                </span>
                {item.data.tags.slice(0, 3).map((tag) => (
                  <span class="hidden rounded-full border border-primary-foreground/25 px-2.5 py-0.5 text-xs text-primary-foreground/75 sm:inline">
                    {hashtag(tag)}
                  </span>
                ))}
              </span>
            </a>
          ))}
        </div>

        {items.length > 1 && (
          <>
            <div class="absolute right-5 bottom-5 flex gap-2 sm:right-8 sm:bottom-8">
              <button
                type="button"
                data-prev
                aria-label={en ? "Previous news item" : "Föregående nyhet"}
                class="flex size-11 items-center justify-center rounded-xl bg-white/90 text-primary shadow transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                <ChevronLeft className="size-5" aria-hidden="true" />
              </button>
              <button
                type="button"
                data-next
                aria-label={en ? "Next news item" : "Nästa nyhet"}
                class="flex size-11 items-center justify-center rounded-xl bg-white/90 text-primary shadow transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                <ChevronRight className="size-5" aria-hidden="true" />
              </button>
            </div>
            <div class="absolute top-6 right-6 flex gap-1.5 sm:top-10 sm:right-10">
              {items.map((_, i) => (
                <button
                  type="button"
                  data-dot
                  data-active={i === 0 ? "true" : "false"}
                  aria-label={en ? `Show news item ${i + 1}` : `Visa nyhet ${i + 1}`}
                  class="news-dot h-1.5 rounded-full bg-white/40 transition-all hover:bg-white/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                />
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}

<script>
  import "@/scripts/news-slider";
</script>
