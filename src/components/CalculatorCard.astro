---
import { ArrowRight } from "lucide-react";
import CalculatorLevel from "@/components/CalculatorLevel.astro";
import { langOf } from "@/lib/i18n";
import { navItem, type NavItem } from "@/lib/site-nav";
import { ui } from "@/i18n/ui";

interface Props {
  item: NavItem;
}

const lang = langOf(Astro.url.pathname);
const item = navItem(Astro.props.item, lang);
const t = ui[lang];
---

<a
  href={item.href}
  class="group flex h-full flex-col rounded-xl border border-border bg-muted p-6 transition-colors hover:border-primary/40 hover:bg-card"
>
  <span
    class="grid size-11 place-items-center rounded-lg bg-card text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground"
  >
    <item.icon className="size-5" aria-hidden="true" />
  </span>
  <h3 class="mt-5 font-display text-xl font-semibold">{item.title}</h3>
  {item.level && <CalculatorLevel level={item.level} class="mt-1.5" />}
  <p class="mt-2 flex-1 text-sm leading-6 text-muted-foreground">{item.description}</p>
  <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary">
    {t["card.open"]}
    {lang === "en" && !item.english && <span class="rounded border border-border px-1.5 text-xs font-normal text-muted-foreground">{t.swedishOnly}</span>}
    <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
  </span>
</a>
